{
  "name": "cfi-timeclock",
  "main": "src/index.js",
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/admin",
      "/admin/"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CLOCK",
        "class_name": "Timeclock"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Timeclock"
      ]
    }
  ],
  "observability": {
    "enabled": true
  }
}